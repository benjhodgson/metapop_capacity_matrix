plot_diff_vs_habitat <- function(diff_df, source_group, delta_prefix = "delta_") {
df_sub <- diff_df[diff_df$source_1 %in% source_group & grepl(delta_prefix, diff_df$source_2), ]
ggplot(df_sub, aes(x = habitat_cover, y = abs_diff, color = source_2)) +
geom_line(alpha = 0.8) +
labs(
title = paste0("Absolute Difference in Metapop Capacity\n", unique(gsub("_.*", "", source_group)), " landscapes"),
x = "Habitat Cover",
y = "Absolute Difference",
color = "Delta Scenario"
) +
theme_minimal() +
facet_wrap(~ source_1, ncol = 3) +  # Facet by each source landscape in the group
theme(legend.position = "bottom")
}
# Extract unique source_1 names
unique_sources <- unique(diff_results$source_1)
# Get combinations of aggregation type and movement ability
types <- c("ha", "ma", "la")
magnitudes <- c("50", "500", "5000")
plot_list <- list()
for (type in types) {
for (mag in magnitudes) {
# Build pattern like "ha_.*_50_"
pattern <- paste0("^", type, "_.*_", mag, "_")
# Find matching source_1 names
group_sources <- unique_sources[grepl(pattern, unique_sources)]
if (length(group_sources) == 0) next
# Plot and store
p <- plot_diff_vs_habitat(diff_results, source_group = group_sources)
print(p)  # To display in R
plot_list[[paste0(type, "_", mag)]] <- p
}
}
