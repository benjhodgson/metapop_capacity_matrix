# Calculate Differences ---------------------------------------------------
rm(list = ls())
library(tidyverse)
library(mgcv)
library(patchwork)
delta_df <- read.csv("Results_Folder/Matrix Permeability and Metapopulation Capacity/Model 1/Persistence/delta_df",
header = TRUE)
# remove some movement abilities
delta_df <- delta_df %>%
filter(movement_ability != 10)
delta_df <- delta_df %>%
filter(movement_ability != 100)
delta_df <- delta_df %>%
filter(movement_ability != 1000)
# create data sets for different levels of colonisation/ extinction constants
delta_df_hc <- delta_df
delta_df_mc <- delta_df
delta_df_lc <- delta_df
# calculate delta for high colonisation/ low extinction
delta_df_hc$c_intense <- 0.5
delta_df_hc$c <- delta_df$c_intense * delta_df$delta_factor
