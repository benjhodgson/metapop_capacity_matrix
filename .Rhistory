rm(list = ls())
library(tidyverse)
library(mgcv)
library(patchwork)
delta_df <- read.csv("Results_Folder/Matrix Permeability and Metapopulation Capacity/Model 1/Persistence/delta_df",
header = TRUE)
# calculate delta
delta_df$c_intense <- 0.1
delta_df$c <- delta_df$c_intense * delta_df$delta_factor
delta_df$e <- 0.1
delta_df$delta <- delta_df$e/delta_df$c
# calculate difference (persistence)
delta_df$difference <- delta_df$metapop_cap - delta_df$delta
# remove some movement abilities
delta_df <- delta_df %>%
filter(movement_ability != 10)
delta_df <- delta_df %>%
filter(movement_ability != 100)
delta_df <- delta_df %>%
filter(movement_ability != 1000)
# Plot graphs -------------------------------------------------------------
plot_df <- delta_df %>%
filter(aggregation == "ma") %>%
filter(dispersal == "md")
plot_df_null <- plot_df %>%
filter(movement == "none") %>%
filter(movement_ability == "0")
plot_df_linear <- plot_df %>%
filter(movement == "linear") %>%
filter(movement_ability == "500")
plot_df_convex <- plot_df %>%
filter(movement == "convex") %>%
filter(movement_ability == "500")
plot_df_concave <- plot_df %>%
filter(movement == "concave") %>%
filter(movement_ability == "500")
# Function for plot
make_plot <- function(data, title) {
ggplot(data, aes(x = habitat_cover, y = (difference), color = interaction(delta_movement, delta_movement_ability))) +
geom_point() +
labs(title = title, x = "Habitat Cover", y = "Difference", color = "Delta Response") +
theme_minimal()
}
# Create plots
p1 <- make_plot(plot_df_null, "Null")
p2 <- make_plot(plot_df_linear, "Linear")
p3 <- make_plot(plot_df_concave, "Concave")
p4 <- make_plot(plot_df_convex, "Convex")
# Combine plots side by side
combined_plot <- p1 + p2 + p3 + p4 + plot_layout(ncol = 2) + plot_layout(guides = "collect")
# Display
print(combined_plot)
