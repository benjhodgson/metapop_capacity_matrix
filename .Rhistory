plot_diff_vs_habitat <- function(diff_df, source1, delta_prefix = "delta_", facet = FALSE) {
# Filter for the chosen ha_vld source_1 and its comparisons
df_sub <- diff_df[diff_df$source_1 == source1 & grepl(delta_prefix, diff_df$source_2), ]
# Plot
p <- ggplot(df_sub, aes(x = habitat_cover, y = abs_diff, color = source_2)) +
geom_line(alpha = 0.9) +
labs(
title = paste("Abs. Difference vs Habitat Cover for", source1),
x = "Habitat Cover",
y = "Absolute Difference in Metapop Capacity",
color = "Delta Scenario"
) +
theme_minimal()
if (facet) {
p <- p + facet_wrap(~source_2)
}
return(p)
}
