library(tidyverse)
plot_df_500 <- delta_df %>%
filter(aggregation == "la") %>%
filter(dispersal == "md") %>%
filter(delta_movement == "linear") %>%
filter(delta_movement_ability == "50") %>%
filter(movement_ability  %in% c("0", "500"))
plot_df_500_mid <- delta_df %>%
filter(aggregation == "ma") %>%
filter(dispersal == "md") %>%
filter(delta_movement == "linear") %>%
filter(delta_movement_ability == "50") %>%
filter(movement_ability  %in% c("0", "500"))
plot_df_500_high <- delta_df %>%
filter(aggregation == "ha") %>%
filter(dispersal == "md") %>%
filter(delta_movement == "linear") %>%
filter(delta_movement_ability == "50") %>%
filter(movement_ability  %in% c("0", "500"))
plot_df_500$movement <- as.factor(plot_df_500$movement)
plot_df_500_mid$movement <- as.factor(plot_df_500_mid$movement)
p1 <- ggplot(plot_df_500, aes(x = (habitat_cover), y = (difference), shape = (movement), colour = movement)) +
geom_point(alpha = 0.8) +
ylim(-1, 1500000) +
labs(title = "Low aggregation", x = "Habitat Cover", y = "Difference", color = "Delta Response") +
theme_minimal()
p2 <- ggplot(plot_df_500_mid, aes(x = (habitat_cover), y = (difference), shape = (movement), colour = movement)) +
geom_point(alpha = 0.8) +
ylim(-1, 1500000) +
labs(title = "Medium aggregation", x = "Habitat Cover", y = "Difference", color = "Delta Response") +
theme_minimal()
p3 <- ggplot(plot_df_500_high, aes(x = (habitat_cover), y = (difference), shape = (movement), colour = movement)) +
geom_point(alpha = 0.8) +
ylim(-1, 1500000) +
labs(title = "High aggregation", x = "Habitat Cover", y = "Difference", color = "Delta Response") +
theme_minimal()
# Combine plots side by side
combined_plot <- p1 + p2 + p3 + plot_layout(ncol = 3) + plot_layout(guides = "collect")
# Display
print(combined_plot)
