library(tidyverse)
plot_df_convex <- delta_df %>%
filter(aggregation == "ha") %>%
filter(dispersal == "ld") %>%
filter(movement == "convex") %>%
filter(delta_movement == "linear") %>%
filter(delta_movement_ability == "50") %>%
filter(movement_ability  %in% c("5000"))
# Find extreme values of inter patch distance
x_min <- 15
x_max <- 30
# Filter for the range
df_extrema <- plot_df_convex %>%
filter(habitat_cover >= x_min, habitat_cover <= x_max)
ranked_data <- df_extrema %>%
filter(habitat_cover >= x_min, habitat_cover <= x_max) %>%
arrange(difference) %>%
mutate(diff_rank = rank(difference, ties.method = "first"))
p1 <- ggplot(plot_df_convex, aes(x = (habitat_cover), y = (mean_distance))) +
geom_point(shape = 21) +
geom_point(data = ranked_data, aes(x = habitat_cover, y = mean_distance, color = diff_rank), size = 2) +
scale_color_viridis_c(option = "plasma", name = "Difference Rank") +
labs(title = "Convex, High aggregation, Low dispersal", x = "Habitat Cover", y = "Mean Inter-Patch Distance (km)") +
theme_minimal()
p2 <- ggplot(plot_df_convex, aes(x = (habitat_cover), y = (difference))) +
geom_point(shape = 21) +
geom_point(data = ranked_data, aes(x = habitat_cover, y = difference, color = diff_rank), size = 2) +
scale_color_viridis_c(option = "plasma", name = "Rank") +
labs( x = "Habitat Cover", y = "Difference") +
theme_minimal()
# Combine plots side by side
combined_plot <- p1 + p2 + plot_layout(ncol = 2) + plot_layout(guides = "collect")
# Display
print(combined_plot)
# model <- lm(difference ~ edge_density * num_patches * mean_patch_size * mean_distance, data = df_extrema)
#
# summary(model)
#
# plot(x = df_extrema$mean_patch_size, y = df_extrema$difference)
library(tidyverse)
plot_df_convex <- delta_df %>%
filter(aggregation == "ha") %>%
filter(dispersal == "ld") %>%
filter(movement == "convex") %>%
filter(delta_movement == "linear") %>%
filter(delta_movement_ability == "50") %>%
filter(movement_ability  %in% c("5000"))
# Find extreme values of inter patch distance
x_min <- 20
x_max <- 22
# Filter for the range
df_extrema <- plot_df_convex %>%
filter(habitat_cover >= x_min, habitat_cover <= x_max)
diff_max <- max(df_extrema$difference)
diff_min <- min(df_extrema$difference)
row_max <- which(plot_df_convex$difference == diff_max)
row_min <- which(plot_df_convex$difference == diff_min)
data_list <- readRDS("Results_Folder/Matrix Permeability and Metapopulation Capacity/Model 1/ha/Result_Final_ha_ld")
landscape_min <- data_list$result_final_convex_5000[[row_min]][[2]]
landscape_max <- data_list$result_final_convex_5000[[row_max]][[2]]
p1 <-
ggplot(landscape_min, aes(x = x, y = y, fill = factor(layer))) +
geom_raster() +
scale_fill_manual(
values = c("0" = "orange", "1" = "darkgreen"),
labels = c("0" = "Non-habitat", "1" = "Habitat"),
name = "Habitat"
) +
coord_equal() +
theme_minimal() +
ggtitle("Difference = ",round(diff_min,1))
p2 <-
ggplot(landscape_max, aes(x = x, y = y, fill = factor(layer))) +
geom_raster() +
scale_fill_manual(
values = c("0" = "orange", "1" = "darkgreen"),
labels = c("0" = "Non-habitat", "1" = "Habitat"),
name = "Habitat"
) +
coord_equal() +
theme_minimal() +
ggtitle("Difference = ",round(diff_max,1))
# Combine plots side-by-side with shared legend
combined_plot <- p1 + p2 + plot_layout(guides = "collect") & theme(legend.position = "bottom")
# Print the combined plot
combined_plot
library(tidyverse)
library(mgcv)
library(patchwork)
# Plot graphs -------------------------------------------------------------
plot_df <- delta_df %>%
filter(aggregation == "la") %>%
filter(dispersal == "vld")
plot_df_null <- plot_df %>%
filter(movement == "none") %>%
filter(movement_ability == "0")
plot_df_linear <- plot_df %>%
filter(movement == "linear") %>%
filter(movement_ability == "5000")
plot_df_convex <- plot_df %>%
filter(movement == "convex") %>%
filter(movement_ability == "5000")
plot_df_concave <- plot_df %>%
filter(movement == "concave") %>%
filter(movement_ability == "5000")
# Function for plot
make_plot <- function(data, title) {
ggplot(data, aes(x = habitat_cover, y = (difference), color = interaction(delta_movement, delta_movement_ability))) +
geom_point() +
labs(title = title, x = "Habitat Cover", y = "Difference", color = "Delta Response") +
theme_minimal()
}
# Create plots
p1 <- make_plot(plot_df_null, "Null")
p2 <- make_plot(plot_df_linear, "Linear")
p3 <- make_plot(plot_df_concave, "Concave")
p4 <- make_plot(plot_df_convex, "Convex")
# Combine plots side by side
combined_plot <- p1 + p2 + p3 + p4 + plot_layout(ncol = 2) + plot_layout(guides = "collect")
main_title = "Low aggregation, Very low dispersal, 5000% increase"
combined_plot + plot_annotation(title = main_title)
