plot_diff_vs_habitat <- function(diff_df, source_group, type, mag, delta_prefix = "delta_") {
df_sub <- diff_df[diff_df$source_1 %in% source_group & grepl(delta_prefix, diff_df$source_2), ]
# Create lookup for dispersal levels (you can modify this as needed)
dispersal_lookup <- c(
"vld" = "Very Low Dispersal",
"ld"  = "Low Dispersal",
"md"  = "Medium Dispersal",
"hd"  = "High Dispersal",
"vhd" = "Very High Dispersal"
)
# Extract dispersal and shape info from source_1
df_sub$facet_label <- vapply(df_sub$source_1, function(name) {
parts <- unlist(strsplit(name, "_"))
disp <- parts[3]  # e.g., vhd
shape <- parts[4] # e.g., convex
paste(dispersal_lookup[[disp]], "-", tools::toTitleCase(shape))
}, character(1))
# Set factor levels to control facet order
dispersal_order <- c("vhd", "hd", "md", "ld", "vld")
shapes <- unique(sapply(strsplit(df_sub$source_1, "_"), `[`, 4))
all_labels <- as.vector(outer(dispersal_order, shapes, function(d, s) {
paste(dispersal_lookup[d], "-", tools::toTitleCase(s))
}))
df_sub$facet_label <- factor(df_sub$facet_label, levels = all_labels)
# Human-readable main title
type_label <- switch(type,
"ha" = "Low Aggregation",
"ma" = "Medium Aggregation",
"la" = "High Aggregation",
type)
mag_label <- paste0(mag, "% Movement Increase")
ggplot(df_sub, aes(x = habitat_cover, y = abs_diff, color = source_2)) +
geom_line(alpha = 0.8) +
labs(
title = paste("Absolute Difference in Metapopulation Capacity –", type_label, "–", mag_label),
x = "Habitat Cover",
y = "Absolute Difference",
color = "Delta Scenario"
) +
theme_minimal() +
facet_wrap(~ facet_label, ncol = 3, scales = "free_y") +
theme(legend.position = "bottom")
}
